{
  "name": "qq-local",
  "version": "1.2.6",
  "description": "QQ宠物·离线+AI版 - Windows 桌宠，本体离线运行，AI 能力可选接入多服务商 LLM（默认关闭）",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:win:nsis": "electron-builder --win nsis",
    "build:win:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.3.4",
    "crypto-js": "^4.1.1",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "iconv-lite": "^0.6.3",
    "node-xlsx": "^0.23.0",
    "nodejs-websocket": "^1.7.2"
  },
  "author": "Daiyimo",
  "repository": "https://github.com/xuemian168/qqpet_automation",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "publish": null,
    "appId": "com.qqlocal.desktop",
    "productName": "QQ宠物离线+AI版",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "!src/**/node_modules",
      "!**/*.map"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QQ宠物离线+AI版"
    },
    "portable": {
      "artifactName": "QQ宠物离线+AI版-${version}-portable.exe"
    }
  }
}
