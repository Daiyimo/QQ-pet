{
  "name": "qq-local",
  "version": "0.1.0",
  "description": "QQ宠物·云端版 - Windows 桌宠，AI 能力全部走云端多服务商 LLM",
  "license": "SEE LICENSE IN ../LICENSE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:win:nsis": "electron-builder --win nsis",
    "build:win:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.3.4",
    "crypto-js": "^4.1.1",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "iconv-lite": "^0.6.3",
    "node-xlsx": "^0.23.0",
    "nodejs-websocket": "^1.7.2"
  },
  "author": "xuemian168",
  "repository": "https://github.com/xuemian168/qqpet_automation",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "publish": null,
    "appId": "com.qqlocal.desktop",
    "productName": "QQ宠物云端版",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "!src/**/node_modules",
      "!**/*.map"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QQ宠物云端版"
    },
    "portable": {
      "artifactName": "QQ宠物云端版-${version}-portable.exe"
    }
  }
}
